# Configuracao do Banco de Dados Local (Somente Leitura)
DATABASE_PATH=data/emplacamentos_synthetic.db

# Configuracao do Provedor de LLM (mock | claude)
# Importante: Nenhum dado do banco (nem sintetico) sobe para o LLM.
# Modelo padrao homologado no projeto: Claude Haiku 5.5
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Seguranca e Privacidade (Secao 7)
MIN_K_ANONYMITY=5
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_BYTES=65536

# Auditoria e Logs
LOG_FILE_PATH=logs/audit.jsonl
